PORT=5000

# ================================================================
# SUPABASE CONFIGURATION
# 1. Sign up / login at https://supabase.com
# 2. Create a new project (e.g. "hr-portal")
# 3. Go to Project Settings -> API
# 4. Copy "Project URL" and paste below into SUPABASE_URL
# 5. Copy "anon public" or "service_role" API key and paste below
# ================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here
