{
  "name": "hr-placement-portal",
  "version": "1.0.0",
  "description": "Global Minds Technologies Hire From Us Portal & Resume Hub",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "server": "node --watch server/server.js",
    "client": "npm --prefix client run dev",
    "sync": "node server/syncResumes.js",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "hr-portal",
    "hire-from-us",
    "qspiders",
    "react",
    "vite",
    "resumes"
  ]
}
